{
  "$schema": "AcmeUI Web semantic tokens. Source of truth: edit this file, then run `node scripts/build-tokens.mjs`.",
  "prefix": "acme",
  "themes": {
    "light": {
      "selector": ":root",
      "colorScheme": "light",
      "colors": {
        "background": "#fff",
        "foreground": "#101828",
        "surface": "#fff",
        "surface-muted": "#f8fafc",
        "primary": "#4f46e5",
        "primary-hover": "#4338ca",
        "primary-foreground": "#fff",
        "secondary": "#eef2ff",
        "secondary-foreground": "#3730a3",
        "muted": "#f1f5f9",
        "muted-foreground": "#64748b",
        "border": "#e2e8f0",
        "input": "#cbd5e1",
        "ring": "#6366f1",
        "success": "#16a34a",
        "warning": "#d97706",
        "danger": "#dc2626",
        "info": "#0284c7",
        "overlay": "rgba(2,6,23,.58)"
      },
      "radius": {
        "sm": ".375rem",
        "md": ".625rem",
        "lg": ".875rem",
        "xl": "1.25rem"
      },
      "shadow": {
        "sm": "0 1px 2px rgba(15,23,42,.06)",
        "md": "0 8px 24px rgba(15,23,42,.10)",
        "lg": "0 20px 50px rgba(15,23,42,.14)"
      },
      "font": {
        "sans": "Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif",
        "mono": "\"JetBrains Mono\",ui-monospace,Consolas,monospace"
      }
    },
    "dark": {
      "selector": "[data-theme=dark]",
      "colorScheme": "dark",
      "colors": {
        "background": "#0b1020",
        "foreground": "#edf2f7",
        "surface": "#111827",
        "surface-muted": "#172033",
        "primary": "#818cf8",
        "primary-hover": "#a5b4fc",
        "primary-foreground": "#111827",
        "secondary": "#252d4a",
        "secondary-foreground": "#c7d2fe",
        "muted": "#1e293b",
        "muted-foreground": "#94a3b8",
        "border": "#334155",
        "input": "#475569",
        "ring": "#a5b4fc"
      }
    }
  }
}
