{
  "name": "acmeui-web",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-framework static UI component library and template platform.",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "pnpm --filter @acmeui/gallery dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck && pnpm typecheck:tests",
    "lint": "node scripts/build-tokens.mjs --check && node scripts/validate.mjs && node scripts/validate-skill.mjs",
    "test": "node scripts/build-tokens.mjs --check && node scripts/validate.mjs && node scripts/validate-skill.mjs && node scripts/test-cli.mjs --compile && vitest run",
    "tokens:build": "node scripts/build-tokens.mjs",
    "gallery": "pnpm --filter @acmeui/gallery dev",
    "create": "node packages/cli/bin/acmeui.mjs create",
    "preview:static": "node scripts/serve-static.mjs",
    "test:unit": "vitest run",
    "typecheck:tests": "vue-tsc --noEmit -p tsconfig.tests.json",
    "test:cli:installed": "node scripts/test-cli.mjs --installed",
    "test:browser": "node scripts/test-browser.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.1",
    "axe-core": "^4.14.0",
    "html-validate": "^9.7.1",
    "jsdom": "^26.1.0",
    "parse5": "^7.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.2",
    "vite": "^8.1.5",
    "vitest": "^3.2.7",
    "vue": "^3.5.40",
    "vue-tsc": "^3.0.7"
  }
}
