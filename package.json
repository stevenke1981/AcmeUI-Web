{
  "name": "acmeui-web",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-framework static UI component library and template platform.",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "pnpm --filter @acmeui/gallery dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "node scripts/build-tokens.mjs --check && node scripts/validate.mjs && node scripts/validate-skill.mjs",
    "test": "node scripts/build-tokens.mjs --check && node scripts/validate.mjs && node scripts/validate-skill.mjs && node scripts/test-cli.mjs --compile && vitest run",
    "tokens:build": "node scripts/build-tokens.mjs",
    "gallery": "pnpm --filter @acmeui/gallery dev",
    "create": "node packages/cli/bin/acmeui.mjs create",
    "preview:static": "node scripts/serve-static.mjs",
    "test:unit": "vitest run"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.1",
    "axe-core": "^4.14.0",
    "jsdom": "^26.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.2",
    "vitest": "^3.2.7",
    "vue": "^3.5.40"
  }
}
